# Puerto donde escucha el Grid Server (HTTP + WebSocket)
PORT=8080

# Clave que debe enviar /operador en el header x-operator-key
OPERATOR_KEY=changeme

# Destinos OSC separados por coma: host:puerto,host:puerto
# Ej: Mac mini (proyección) y MacBook (Ableton/M4L)
OSC_TARGETS=192.168.1.20:9000,192.168.1.21:9001
