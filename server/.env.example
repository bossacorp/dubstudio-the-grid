# Puerto donde escucha el Grid Server (HTTP + WebSocket)
PORT=8080

# Clave del operador: se pide al entrar a /operador (y header x-operator-key
# para POST /operador/lock). Cámbiala: si queda en "changeme" el log avisa.
OPERATOR_KEY=changeme

# Destinos OSC separados por coma: host:puerto,host:puerto
# Fase 0: Max en la Mac mini. "osc-monitor:9000" es el monitor de prueba
# (perfil "monitor" del compose); quítalo si no lo levantas.
OSC_TARGETS=osc-monitor:9000,192.168.1.20:9000

# Puerto UDP donde el servidor recibe OSC (/show/bar desde Max)
OSC_IN_PORT=9100
